<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="UserDao">

    <!--회원가입-->
    <insert id="insertUser" parameterType="UserDto">
        INSERT INTO teampack.users(user_email, user_password, user_name)
        VALUES (#{userEmail}, #{userPassword}, #{userName})
    </insert>

    <!-- 이메일 중복 체크 -->
    <select id="selectByEmail" parameterType="String" resultType="UserDto">
        SELECT * FROM teampack.users WHERE user_email = #{email}
    </select>

</mapper>
